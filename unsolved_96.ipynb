   "source": [
    "96. Unique Binary Search Trees\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "41e4c064",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Solution:\n",
    "    def numTrees(self, n: int) -> int:\n",
    "        dp = [0]*(n+1)\n",
    "        dp[0] = 1\n",
    "        dp[1] = 1\n",
    "        count = 1\n",
    "        for i in range(2, n+1):\n",
    "\n",
    "            count =  (i - 1) + i\n",
    "            dp[i] = count\n",
    "        return count"
   ]
  },
